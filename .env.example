# ShiftAI :: client-side configuration.
# Copy to .env.local and fill in from: Supabase dashboard > Project Settings > API.
#
# Only these two values belong in an app bundle. They are safe to ship because
# every table is protected by row level security.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"

# NEVER put the service role key in a client app, a mobile binary, or any file
# that reaches a browser. It bypasses row level security and can decrypt every
# stored provider key. Edge functions receive it automatically from the platform;
# for local admin scripts, export it in your shell instead of committing it.
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Optional: restrict which origins the edge functions answer (comma separated).
# Set with: supabase secrets set SHIFTAI_ALLOWED_ORIGINS="https://shiftai.app"
# SHIFTAI_ALLOWED_ORIGINS="*"
