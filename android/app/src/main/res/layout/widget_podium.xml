<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEADERBOARD"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- 2nd -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal">
            <TextView
                android:id="@+id/podium_2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center" />
            <TextView
                android:id="@+id/podium_2_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 1st -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal">
            <TextView
                android:id="@+id/podium_1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_accent"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center" />
            <TextView
                android:id="@+id/podium_1_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3rd -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal">
            <TextView
                android:id="@+id/podium_3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center" />
            <TextView
                android:id="@+id/podium_3_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
